<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <!-- CameraX fallback preview; letterboxed like the Camera2 preview so both show the recorded frame. -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fitCenter" />

    <com.precorderone.ui.AspectFitSurfaceView
        android:id="@+id/highSpeedPreviewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone" />

    <View
        android:id="@+id/focusRing"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_focus_ring"
        android:visibility="invisible" />

    <!-- Top bar: buffer state, recording profile, quick toggles. -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_scrim_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/statusChip"
            style="@style/Widget.PrecorderOne.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            android:text="@string/status_starting"
            app:drawableStartCompat="@drawable/ic_status_dot" />

        <TextView
            android:id="@+id/profileChip"
            style="@style/Widget.PrecorderOne.Chip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary" />

        <ImageButton
            android:id="@+id/btnExposure"
            style="@style/Widget.PrecorderOne.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/exposure_button"
            android:src="@drawable/ic_exposure" />

        <ImageButton
            android:id="@+id/btnTorch"
            style="@style/Widget.PrecorderOne.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/torch_button"
            android:src="@drawable/ic_flash_off" />

        <ImageButton
            android:id="@+id/btnSettings"
            style="@style/Widget.PrecorderOne.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/settings_button"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!-- Diagnostics, only when enabled in the settings. -->
    <TextView
        android:id="@+id/debugFpsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="72dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_chip"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:text="@string/debug_fps_initial"
        android:textColor="#7CFC00"
        android:textSize="10sp"
        android:visibility="gone" />

    <!-- Bottom area: exposure, focus state, lens bar, shutter row. -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_scrim_bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="32dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:id="@+id/exposurePanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/exposureText"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/exposure_zero"
                android:textColor="@android:color/white"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/exposureSlider"
                android:layout_width="200dp"
                android:layout_height="40dp"
                android:max="12"
                android:progress="6" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnFocusAuto"
            style="@style/Widget.PrecorderOne.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/focus_auto_button"
            android:text="@string/focus_locked_chip"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/zoomControlsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_lens_bar"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="4dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/lastClipThumb"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="36dp"
                android:background="@drawable/bg_thumb"
                android:contentDescription="@string/last_clip_button"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:visibility="invisible" />

            <FrameLayout
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_gravity="center">

                <!-- Buffer fill as ring around the shutter: amber while filling, green when a full clip is ready. -->
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/bufferRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:max="100"
                    app:indicatorColor="@color/buffer_amber"
                    app:indicatorSize="88dp"
                    app:trackColor="#33FFFFFF"
                    app:trackCornerRadius="2dp"
                    app:trackThickness="4dp" />

                <ImageButton
                    android:id="@+id/btnTrigger"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_shutter"
                    android:contentDescription="@string/trigger_button"
                    android:scaleType="center"
                    android:src="@drawable/ic_record_dot" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/btnSwitchCamera"
                style="@style/Widget.PrecorderOne.IconButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="36dp"
                android:contentDescription="@string/switch_camera_button"
                android:padding="13dp"
                android:src="@drawable/ic_switch_camera" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
