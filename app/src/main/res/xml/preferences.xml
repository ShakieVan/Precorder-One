<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/pref_category_recording">

        <ListPreference
            app:defaultValue="5"
            app:entries="@array/loop_entries"
            app:entryValues="@array/loop_values"
            app:iconSpaceReserved="false"
            app:key="loop_seconds"
            app:title="Puffer-Länge"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="0"
            app:entries="@array/post_roll_entries"
            app:entryValues="@array/post_roll_values"
            app:iconSpaceReserved="false"
            app:key="post_roll"
            app:title="@string/pref_post_roll_title"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="60"
            app:iconSpaceReserved="false"
            app:key="target_fps"
            app:title="Aufnahme-Bildrate"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="30"
            app:entries="@array/playback_entries"
            app:entryValues="@array/playback_values"
            app:iconSpaceReserved="false"
            app:key="playback_fps"
            app:title="Wiedergabe-Bildrate (Zeitlupe)"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="16:9"
            app:entries="@array/aspect_entries"
            app:entryValues="@array/aspect_values"
            app:iconSpaceReserved="false"
            app:key="aspect_ratio"
            app:title="Seitenverhältnis"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="record_audio"
            app:summary="@string/pref_audio_summary"
            app:title="@string/pref_audio_title" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/pref_category_camera">

        <ListPreference
            app:defaultValue="back"
            app:entries="@array/lens_entries"
            app:entryValues="@array/lens_values"
            app:iconSpaceReserved="false"
            app:key="lens_facing"
            app:title="Kamera"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:iconSpaceReserved="false"
            app:key="camera_id"
            app:title="Kamera-Modul"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="torch"
            app:title="Kameralicht" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/pref_category_storage">

        <Preference
            app:iconSpaceReserved="false"
            app:key="output_uri"
            app:title="Speicherort" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/pref_category_controls">

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="volume_trigger"
            app:summary="@string/pref_keys_summary"
            app:title="@string/pref_keys_title" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="show_diagnostics"
            app:summary="@string/pref_diagnostics_summary"
            app:title="@string/pref_diagnostics_title" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/pref_category_app">

        <Preference
            app:iconSpaceReserved="false"
            app:key="app_version"
            app:selectable="false"
            app:title="@string/pref_version_title" />

        <Preference
            app:iconSpaceReserved="false"
            app:key="app_update"
            app:title="@string/pref_update_title" />
    </PreferenceCategory>
</PreferenceScreen>
