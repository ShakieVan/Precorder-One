<!-- Ripple only shows on clickable chips (status/profile); the shape alone backs passive labels. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#40FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/scrim" />
        </shape>
    </item>
</ripple>
